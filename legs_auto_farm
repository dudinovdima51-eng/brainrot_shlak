local function getFootPos()
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local lf = char:FindFirstChild("LeftFoot")
    local rf = char:FindFirstChild("RightFoot")
    if lf and rf then
        return Vector3.new(hrp.Position.X, math.min(lf.Position.Y, rf.Position.Y), hrp.Position.Z)
    end
    return Vector3.new(hrp.Position.X, hrp.Position.Y - 2.5, hrp.Position.Z)
end

local function buildPlatform(pos)
    local p = Instance.new("Part")
    p.Name     = "AutoFarmPlatform"
    p.Size     = Vector3.new(6, 0.3, 6)
    p.Position = pos
    p.Anchored = true
    p.CanCollide = true
    p.Transparency = 0.25
    p.BrickColor = BrickColor.new("Cyan")
    p.Material = Enum.Material.Neon
    p.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
    p.Parent = workspace
    return p
end

local function spawnPlatform()
    if currentPlat then pcall(function() currentPlat:Destroy() end) end
    local fp = getFootPos()
    if not fp then return end
    currentPlat = buildPlatform(Vector3.new(fp.X, fp.Y - 3, fp.Z))
    platSpawned = true
    setStatus("Platform spawned 3 studs below", C.ACCENT)
    addLog("Platform spawned", C.ACCENT)
end

local function removePlatform()
    if currentPlat then pcall(function() currentPlat:Destroy() end) end
    currentPlat = nil
    platSpawned = false
    setStatus("Platform removed", C.AMBER)
    addLog("Platform removed", C.AMBER)
end

local function respawnPlatform()
    if not platSpawned then return end
    if currentPlat then pcall(function() currentPlat:Destroy() end) end
    local fp = getFootPos()
    if not fp then return end
    currentPlat = buildPlatform(Vector3.new(fp.X, fp.Y - 3, fp.Z))
end

-- ============================================
-- TELEPORT FUNCTIONS
-- ============================================

local function findParts()
    local result = {}
    for _, p in ipairs(workspace:GetDescendants()) do
        if p:IsA("BasePart") then
            local ok, len = pcall(function() return p:GetAttribute("Length") end)
            if ok and type(len) == "number" and len > 150 then
                table.insert(result, {part = p, length = len})
            end
        end
    end
    table.sort(result, function(a, b) return a.length > b.length end)
    return result
end

local function refreshTargetUI()
    validParts = findParts()
    if #validParts == 0 then
        targetNameLbl.Text  = "No parts found (Length > 150)"
        targetLengthLbl.Text = "len: —"
        targetNameLbl.TextColor3 = C.RED
        return false
    end
    local best = validParts[1]
    targetNameLbl.Text  = best.part.Name
    targetLengthLbl.Text = "len: " .. best.length
    targetNameLbl.TextColor3 = C.GREEN
    tpProg.Size = UDim2.new(math.min(#validParts / 10, 1), 0, 0, 3)
    return true
end

local function getNextTarget()
    validParts = findParts()
    if #validParts == 0 then return nil end
    if currentIdx > #validParts then currentIdx = 1 end
    local t = validParts[currentIdx]
    currentIdx += 1
    return t.part
end

local function doFreeze(dur)
    isFrozen = true
    local char = player.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            local ws, jp = hum.WalkSpeed, hum.JumpPower
            hum.WalkSpeed = 0; hum.JumpPower = 0; hum.PlatformStand = true
            task.wait(dur)
            hum.WalkSpeed = ws; hum.JumpPower = jp; hum.PlatformStand = false
        end
    end
    isFrozen = false
end

local function doTeleport()
    if isFrozen then return false end
    local target = getNextTarget()
    if not target then setStatus("No valid target found", C.RED) return false end
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0)
    totalTPs += 1

    targetNameLbl.Text   = target.Name
    targetLengthLbl.Text = "len: " .. (target:GetAttribute("Length") or "?")
    stTPs.Text = tostring(totalTPs)
    setStatus("Teleported to " .. target.Name, C.ACCENT)
    addLog("TP → " .. target.Name, C.ACCENT)

    task.wait(0.05)
    respawnPlatform()
    task.spawn(doFreeze, 0.1)
    return true
end

local function startAutoTP()
    if autoTPCoro then task.cancel(autoTPCoro) end
    autoTPActive = true
    autoTPBtn.BackgroundColor3 = C.ACCENT
    autoTPBtn.TextColor3 = C.WHITE
    autoTPBtn.Text = "Auto: ON"
    setStatus("Auto teleport running (" .. tpInterval .. "s)", C.ACCENT)
    spawnPlatform()
    refreshTargetUI()
    currentIdx = 1

    autoTPCoro = task.spawn(function()
        while autoTPActive do
            task.wait(tpInterval)
            if autoTPActive then doTeleport() end
        end
    end)
end

local function stopAutoTP()
    autoTPActive = false
    if autoTPCoro then task.cancel(autoTPCoro) end
    autoTPBtn.BackgroundColor3 = C.BG_CARD
    autoTPBtn.TextColor3 = C.TEXT_SEC
    autoTPBtn.Text = "Auto: OFF"
    setStatus("Auto teleport stopped", C.AMBER)
    removePlatform()
end

