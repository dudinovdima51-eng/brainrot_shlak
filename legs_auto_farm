-- SELL FUNCTIONS
-- ============================================

local function updateSizeUI()
    local v = sizeStat.Value
    sizeValLbl.Text = tostring(v)
    threshLbl.Text  = tostring(sellThreshold)
    local pct = math.clamp(v / sellThreshold, 0, 1)
    sizeProgFill.Size = UDim2.new(pct, 0, 0, 5)
    sizeValLbl.TextColor3 = (v >= sellThreshold) and C.GREEN or C.AMBER
end

local function doSell()
    local now = tick()
    if now - lastSellTime < sellCooldown then return false end
    local v = sizeStat.Value
    local ok = pcall(function() sellLegsRemote:FireServer() end)
    if ok then
        totalSells += 1
        lastSellTime = now
        sellsLbl.Text = tostring(totalSells)
        stSells.Text  = tostring(totalSells)
        setStatus("Sold! (" .. v .. " size → " .. totalSells .. " sells)", C.GREEN)
        addLog("Sold at size " .. v, C.GREEN)
        return true
    end
    return false
end

local function checkSell()
    if autoSellActive and sizeStat.Value >= sellThreshold then
        doSell()
    end
end

