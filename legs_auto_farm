-- E SPAM FUNCTIONS
-- ============================================

local function startESpam()
    if eSpamConn then eSpamConn:Disconnect() end
    eSpamActive = true
    spamToggleBtn.BackgroundColor3 = C.GREEN_DIM
    spamToggleBtn.TextColor3 = C.GREEN
    spamToggleBtn.Text = "Spam: ON"
    pingDot.BackgroundColor3 = C.GREEN

    local last = tick()
    eSpamConn = runService.Heartbeat:Connect(function()
        if eSpamActive and (tick() - last) >= eSpamRate then
            last = tick()
            local vim = game:GetService("VirtualInputManager")
            if vim then
                vim:SendKeyEvent(true, "E", false, game)
                task.wait()
                vim:SendKeyEvent(false, "E", false, game)
            end
        end
    end)
    addLog("E spam started (" .. math.floor(eSpamRate*1000) .. "ms)", C.ACCENT)
end

local function stopESpam()
    eSpamActive = false
    if eSpamConn then eSpamConn:Disconnect() end
    spamToggleBtn.BackgroundColor3 = C.RED_DIM
    spamToggleBtn.TextColor3 = C.RED
    spamToggleBtn.Text = "Spam: OFF"
    pingDot.BackgroundColor3 = C.TEXT_DIM
    addLog("E spam stopped", C.AMBER)
end

